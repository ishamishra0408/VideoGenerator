        {
          "kind": "code",
          "eyebrow": "The voice",
          "heading": "Cached, *four at a time*",
          "lines": [
            "Clips are cached by what was said, so a re-run only pays for new sentences.",
            "Four workers speak in parallel."
          ],
          "code": {
            "file": "src/voice.ts",
            "text": "/** Speaks every line. Returns each clip's file and length in seconds, in order. */\nexport async function speakAll(lines: string[], opts: VoiceOptions, log: (s: string) => void = () => {}): Promise<{ files: string[]; durations: number[]; fresh: number }> {\n  const dir = join(opts.cacheDir, \"voice\");\n  mkdirSync(dir, { recursive: true });\n  const files = lines.map((l) => join(dir, `${clipKey(l, opts.backend)}.wav`));\n  const todo = lines.map((_, i) => i).filter((i) => !existsSync(files[i]));\n  let done = 0;\n  const worker = async () => {\n    for (let i = todo.shift(); i !== undefined; i = todo.shift()) {\n      await makeClip(lines[i], files[i], opts);\n      done++;\n      if (done % 5 === 0) log(`voice: ${done} new clips`);"
          },
          "items": [
            {
              "title": "Cache key",
              "text": "Hash of voice, style and text",
              "on": 0
            },
            {
              "title": "Worker pool",
              "text": "Concurrency of four",
              "on": 1
            }
          ]
