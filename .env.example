# Required: the script writer, Claude through the Claude API (console.anthropic.com).
ANTHROPIC_API_KEY=
# Required, one of these two: the voice, Gemini TTS. GEMINI_API_KEY comes from Google AI Studio (aistudio.google.com/apikey)
# and has a free tier; it's used when both are set. OPENROUTER_API_KEY reaches the same voice through OpenRouter.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: raises GitHub's API limit from 60 to 5,000 requests an hour, and reads private repos you can access.
GITHUB_TOKEN=
# Optional: post films to YouTube. A Google OAuth "Web application" client; see "Post to YouTube" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the only Google account allowed to connect. Leave empty to let anyone connect their own account.
GOOGLE_ALLOWED_EMAIL=
