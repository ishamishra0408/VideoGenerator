# Required: one key for the script writer (Claude via OpenRouter) and the voice (Gemini TTS via OpenRouter).
OPENROUTER_API_KEY=
# Optional: raises GitHub's API limit from 60 to 5,000 requests an hour, and reads private repos you can access.
GITHUB_TOKEN=
# Optional: post films to YouTube. A Google OAuth "Web application" client; see "Post to YouTube" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the only Google account allowed to connect. Leave empty to let anyone connect their own account.
GOOGLE_ALLOWED_EMAIL=
